# ATENȚIE dacă se adaugă vreodată Content-Security-Policy: index.html conține
# un script INLINE în <head> (bootstrap-ul de temă), care trebuie să rămână
# permis. Fără el, preferințele vizuale nu se mai aplică — vezi plasa de
# siguranță pentru mișcare redusă din finalul assets/app.css.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/data/*
  Cache-Control: no-cache

# no-cache = revalidare la fiecare cerere (304 dacă nu s-a schimbat), NU „fără cache".
# Fișierele nu au amprentă în nume, deci un max-age lung servea CSS/JS vechi
# lângă HTML nou timp de 7 zile. Viteza o dă oricum service worker-ul (cache-first).
/assets/*
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=2592000
